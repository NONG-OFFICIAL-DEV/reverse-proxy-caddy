www.nongofficial.store {
    encode gzip

    # Handle API requests first
    handle /api/* {
        reverse_proxy website_api:9090
    }

    handle /* {
        reverse_proxy frontend_website:80
    }

    # Logging
    log {
        output file /var/log/caddy/www-nongofficial.log
        format json
    }
}

# for smartstore-landing
www.nexstacktech.com {
    encode gzip

    handle /api* {
        reverse_proxy saas_website_backend:86
    }

    handle /storage/* {
        reverse_proxy saas_website_backend:86
    }

    handle {
        reverse_proxy smart-store-website:80
    }

    # Logging
    log {
        output file /var/log/caddy/www.nexstacktech.com.log
        format json
    }
}

# for back office mangement
admin.nexstacktech.com {
    encode gzip

    # Laravel Backend - Nginx (also handles the /app Reverb websocket
    # proxy internally, see backend/nginx/default.conf)
    handle /api* {
        reverse_proxy smart_store_webserver:84
    }

    # Route storage requests to Nginx (images)
    handle /storage/* {
        reverse_proxy smart_store_webserver:84
    }

    # Reverb WebSocket - client connections (/app/{key})
    handle /app* {
        reverse_proxy smart_store_webserver:84
    }

    handle {
        reverse_proxy smart_store_frontend:80
    }

    # Logging
    log {
        output file /var/log/caddy/admin.nexstacktech.com.log
        format json
    }
}

pos-cafe.nexstacktech.com {
    reverse_proxy coffee-pos-frontend:80
    encode gzip
    
    # Logging
    log {
        output file /var/log/caddy/coffee-pos.nexstacktech.com.log
        format json
    }
}

pos-retail.nexstacktech.com {
    reverse_proxy retail-pos-frontend:80
    encode gzip
    
    # Logging
    log {
        output file /var/log/caddy/pos-retail.nexstacktech.com.log
        format json
    }
}

# e-menu
e-menu.nexstacktech.com {
    reverse_proxy mobile-menu-frontend-beta:80
    encode gzip

    # Logging
    log {
        output file /var/log/caddy/admin.nexstacktech.com.log
        format json
    }
}

# for Photo Studio SaaS
photo-studio.nexstacktech.com {
    encode gzip

    # Laravel backend API
    handle /api* {
        reverse_proxy photo_studio_webserver:80
    }

    # Uploaded files (storage:link'd public disk)
    handle /storage/* {
        reverse_proxy photo_studio_webserver:80
    }

    # Reverb WebSocket — client connections (/app/{key}) and server-side
    # event publishing (/apps/{id}/events) both start with "/app".
    handle /app* {
        reverse_proxy photo_studio_reverb:8080
    }

    # Everything else -> the Vue SPA
    handle {
        reverse_proxy photo_studio_frontend:80
    }

    # Logging
    log {
        output file /var/log/caddy/photo-studio.nexstacktech.com.log
        format json
    }
}